# Big Sur Glow — GTK 2, variante escura
#
# GTK 2 nao entende @define-color nem a sintaxe do GTK 3: e outra linguagem,
# por estados (NORMAL, PRELIGHT, ACTIVE, SELECTED, INSENSITIVE). Por isso
# este arquivo repete os hexadecimais em vez de referenciar a paleta.
# Se mudar shared/palette.json, mude aqui tambem.
#
# Sem engine: so cores. Um GIMP ou Inkscape nao vai ficar com widget de
# macOS, mas para de destoar do resto da area de trabalho — que e o ponto.
#
# Autor: MarbleCeo

gtk-color-scheme = "fg_color:#E5DEFF\nbg_color:#2B2833\nbase_color:#211E29\ntext_color:#E5DEFF\nselected_bg_color:#D6BCFA\nselected_fg_color:#201B2B\ntooltip_bg_color:#3A3646\ntooltip_fg_color:#E5DEFF"

gtk-auto-mnemonics = 1
gtk-primary-button-warps-slider = 1
gtk-button-images = 0
gtk-menu-images = 0

style "bsg-default" {
  xthickness = 1
  ythickness = 1

  fg[NORMAL]       = @fg_color
  fg[PRELIGHT]     = @fg_color
  fg[ACTIVE]       = @fg_color
  fg[SELECTED]     = @selected_fg_color
  fg[INSENSITIVE]  = "#6E6A7D"

  bg[NORMAL]       = @bg_color
  bg[PRELIGHT]     = "#4A445A"
  bg[ACTIVE]       = "#302C3B"
  bg[SELECTED]     = @selected_bg_color
  bg[INSENSITIVE]  = @bg_color

  base[NORMAL]      = @base_color
  base[PRELIGHT]    = @selected_bg_color
  base[ACTIVE]      = "#5B4E7A"
  base[SELECTED]    = @selected_bg_color
  base[INSENSITIVE] = @bg_color

  text[NORMAL]      = @text_color
  text[PRELIGHT]    = @text_color
  text[ACTIVE]      = @selected_fg_color
  text[SELECTED]    = @selected_fg_color
  text[INSENSITIVE] = "#6E6A7D"

  GtkButton::child-displacement-x = 0
  GtkButton::child-displacement-y = 0
  GtkButton::default-border       = { 0, 0, 0, 0 }
  GtkButton::inner-border         = { 4, 4, 2, 2 }
  GtkCheckButton::indicator-size  = 15
  GtkRange::slider-width          = 14
  GtkRange::trough-border         = 2
  GtkRange::stepper-size          = 0
  GtkScrollbar::has-backward-stepper = 0
  GtkScrollbar::has-forward-stepper  = 0
  GtkScrollbar::min-slider-length    = 32
  GtkScrolledWindow::scrollbar-spacing = 0
  GtkPaned::handle-size           = 1
  GtkTreeView::vertical-separator = 2
  GtkTreeView::odd-row-color      = @base_color
  GtkTreeView::even-row-color     = "#262330"
  GtkMenuBar::internal-padding    = 2
  GtkExpander::expander-size      = 12
  GtkToolbar::internal-padding    = 2
}

style "bsg-menu" {
  bg[NORMAL] = "#363243"
  xthickness = 0
  ythickness = 0
}

style "bsg-menu-item" {
  fg[PRELIGHT] = @selected_fg_color
  bg[PRELIGHT] = @selected_bg_color
}

style "bsg-tooltip" {
  bg[NORMAL] = @tooltip_bg_color
  fg[NORMAL] = @tooltip_fg_color
  xthickness = 4
  ythickness = 4
}

style "bsg-entry" {
  bg[NORMAL]  = @base_color
  base[NORMAL] = @base_color
  xthickness = 4
  ythickness = 4
}

class "GtkWidget"    style "bsg-default"
class "GtkEntry"     style "bsg-entry"
class "GtkMenu"      style "bsg-menu"
class "GtkMenuItem"  style "bsg-menu-item"
widget "gtk-tooltip*" style "bsg-tooltip"
